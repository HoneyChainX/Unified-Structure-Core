# =============================================================================
# Trading bot — environment template
# =============================================================================
# Copy to `.env` (or load into your process supervisor / secret manager) and
# fill in the values marked `xxx`. Anything not in this file is not consumed
# by the api-server — see docs/DEPLOYMENT.md §3 for the full reference.
#
# DO NOT commit your filled-in copy.
# =============================================================================


# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Postgres connection string. Process exits at startup if unset.
# Supabase: use the Session pooler URL from Project Settings → Database.
DATABASE_URL=postgres://user:xxx@host:5432/dbname

# TCP port the api-server binds. Required, must be numeric.
PORT=8080

# TradingView webhook secret. Required when NODE_ENV != "development".
# Send via the `X-Webhook-Secret` HTTP header on every webhook hit.
# Generate with e.g. `openssl rand -hex 32`.
WEBHOOK_SECRET=xxx

# Gate.io API credentials — spot read + spot trade permission only.
# IP-whitelist the server's egress IP on the Gate.io key page.
GATEIO_API_KEY=xxx
GATEIO_API_SECRET=xxx


# -----------------------------------------------------------------------------
# Optional — mobile companion app
# -----------------------------------------------------------------------------
# Set MOBILE_API_TOKEN to enable /api/mobile/* (otherwise every request → 503).
# Set ONE of FCM_SERVICE_ACCOUNT_JSON or FCM_SERVICE_ACCOUNT_PATH to enable
# push notifications. Without either the server runs unchanged but push no-ops.
# See artifacts/mobile/README.md for the app-side setup.

MOBILE_API_TOKEN=xxx

# Inline Firebase service-account JSON (takes precedence over _PATH).
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"xxx",...}

# OR a filesystem path to the same JSON file.
# FCM_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json


# -----------------------------------------------------------------------------
# Optional — Telegram alerts (alternative / addition to FCM)
# -----------------------------------------------------------------------------
# Both must be set to enable. See artifacts/api-server/src/services/notify.ts.

# TELEGRAM_BOT_TOKEN=xxx
# TELEGRAM_CHAT_ID=xxx


# -----------------------------------------------------------------------------
# Optional — Gate.io fee overrides
# -----------------------------------------------------------------------------
# Decimal fee rate, e.g. 0.0009 = 0.09% (the Gate.io spot default for GT
# holders). Override if your tier differs — affects P&L calculations and the
# break-even SL math in the executor.

# GATEIO_TAKER_FEE_RATE=0.0009
# GATEIO_MAKER_FEE_RATE=0.0009


# -----------------------------------------------------------------------------
# Behavioural
# -----------------------------------------------------------------------------
# Set to `production` in production. When set to `development`, the webhook
# route stops requiring WEBHOOK_SECRET and the logger emits pretty output —
# never run prod with development.
NODE_ENV=production

# Pino log level: trace | debug | info | warn | error | fatal. Default `info`.
# LOG_LEVEL=info
