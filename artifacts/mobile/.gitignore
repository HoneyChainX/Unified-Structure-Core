# Build artifacts — regenerated by `pnpm run android:sync` or `pnpm run build`.
dist/

# Capacitor-generated platform projects.
# Each is created locally by `pnpm run android:add` / `cap add android`.
# Operators on different machines will generate slightly different files
# (Gradle wrapper hashes, gen'd manifests, etc.), so we never commit them.
# See artifacts/mobile/README.md for the full Android build flow.
android/
ios/

# Capacitor sync artifacts inside platform projects (defensive — these dirs
# above already shouldn't be tracked).
android/app/src/main/assets/public/

# Firebase credentials — operator drops their google-services.json into
# android/app/ locally. Never commit.
**/google-services.json
**/GoogleService-Info.plist

# Local env / debug files.
.env
.env.local
.firebase/
